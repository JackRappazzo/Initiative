{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": {
        "MongoDb": "mongodb://localhost:27017/Initiative"
    },
    "JwtSettings": {
        "Issuer": "Initiative",
        "Audience": "InitiativeUsers",
        "ExpiresInMinutes": 300,
        "RefreshTokenExpiresInDays": 60
    },
    "AllowedHosts": "*"
}
